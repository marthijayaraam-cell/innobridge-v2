<svg width="120" height="120" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Solid LinkedIn Blue Rounded Badge (#0A66C2) -->
  <rect width="120" height="120" rx="22" fill="#0A66C2" />
  
  <!-- Bold, Crisp White "IB" Monogram + Bridge Architectural Arc -->
  <g fill="#FFFFFF">
    <text
      x="60"
      y="64"
      font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      font-weight="900"
      font-size="70"
      letter-spacing="-6"
      text-anchor="middle"
      dominant-baseline="central"
    >
      IB
    </text>
  </g>
</svg>
